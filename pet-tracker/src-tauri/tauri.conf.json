{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION 2 Pet Tracker",
  "version": "0.1.0",
  "identifier": "com.thomas.aion2.pet-tracker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AION 2 Pet Tracker",
        "width": 960,
        "height": 740,
        "resizable": true
      },
      {
        "label": "popup",
        "title": "Pet Info",
        "url": "popup.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "region-picker",
        "title": "Select nameplate region",
        "url": "region-picker.html",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../data/pets.json"]
  }
}
